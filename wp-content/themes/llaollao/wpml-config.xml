<?xml version="1.0" encoding="UTF-8"?>
<!--
	Configuración de traducción para Polylang Pro / WPML.
	Declara qué atributos de los bloques a medida debe traducir DeepL.
	Polylang lee este archivo automáticamente desde la raíz del tema
	(wpml-config.xml es un estándar compartido: lo leen WPML y Polylang).

	Para arrays de objetos (p. ej. "items"), hay que añadir un nivel con el
	comodín <key name="*"> que representa cada índice del array, y dentro las
	claves de texto a traducir. Sin ese "*" no itera el array y no traduce.

	Solo se declaran campos de TEXTO. No se incluyen URLs, IDs de imagen,
	focal points, números ni booleanos (no son traducibles). Los campos que
	son nombres propios (autor de reseña, nombre del equipo) se incluyen pero
	pueden quitarse si no se desean enviar a DeepL.
-->
<wpml-config>
	<gutenberg-blocks>

		<!-- Banner: texto alternativo de la imagen -->
		<gutenberg-block type="bisiesto/banner" translate="1">
			<key name="imageAlt" />
		</gutenberg-block>

		<!-- FAQs: pregunta/respuesta de cada item -->
		<gutenberg-block type="llaollao/faqs" translate="1">
			<key name="items">
				<key name="*">
					<key name="question" />
					<key name="answer" />
				</key>
			</key>
		</gutenberg-block>

		<!-- Grid links: título y alt de cada elemento (la URL no se traduce) -->
		<gutenberg-block type="llaollao/grid-links" translate="1">
			<key name="items">
				<key name="*">
					<key name="text" />
					<key name="imageAlt" />
				</key>
			</key>
		</gutenberg-block>

		<!-- Marquee: texto en movimiento (array de strings, no de objetos) -->
		<gutenberg-block type="bisiesto/marquee" translate="1">
			<key name="items" />
		</gutenberg-block>

		<!-- Video hero: alt de la portada -->
		<gutenberg-block type="bisiesto/video-hero" translate="1">
			<key name="posterAlt" />
		</gutenberg-block>

		<!-- Video Llaollao: alt de la portada -->
		<gutenberg-block type="bisiesto/video-llaollao" translate="1">
			<key name="posterAlt" />
		</gutenberg-block>

		<!-- Side images: alt de la imagen de cada columna (bloque hijo) -->
		<gutenberg-block type="bisiesto/side-image-column" translate="1">
			<key name="imageAlt" />
		</gutenberg-block>

		<!-- Tabla de contenidos: título -->
		<gutenberg-block type="bisiesto/table-of-contents" translate="1">
			<key name="title" />
		</gutenberg-block>

		<!-- Carta: etiqueta "Todos" -->
		<gutenberg-block type="llaollao/carta" translate="1">
			<key name="allLabel" />
		</gutenberg-block>

		<!-- Vista producto (con slide vertical): etiqueta "Alérgenos" -->
		<gutenberg-block type="llaollao/vista-producto" translate="1">
			<key name="alergenosLabel" />
		</gutenberg-block>

		<!-- Vista producto simple: etiqueta "Alérgenos" -->
		<gutenberg-block type="llaollao/vista-producto-simple" translate="1">
			<key name="alergenosLabel" />
		</gutenberg-block>

		<!-- Slider de imágenes: alt de cada imagen (bloque hijo) -->
		<gutenberg-block type="llaollao/image-slider-item" translate="1">
			<key name="alt" />
		</gutenberg-block>

		<!-- Landing (404 / gracias): alt de cada imagen -->
		<gutenberg-block type="llaollao/landing" translate="1">
			<key name="images">
				<key name="*">
					<key name="alt" />
				</key>
			</key>
		</gutenberg-block>

	</gutenberg-blocks>

	<custom-fields>
		<custom-field action="translate">llao_descripcion</custom-field>
		<custom-field action="translate">llao_variantes</custom-field>
	</custom-fields>

	<custom-fields-texts>
		<key name="llao_variantes">
			<key name="*">
				<key name="texto" />
			</key>
		</key>
	</custom-fields-texts>
</wpml-config>
